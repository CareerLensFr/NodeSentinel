# Configuration de NodeSentinel

# ==========================================
# DISCORD
# ==========================================
# L'URL du Webhook Discord pour envoyer les alertes
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"
# Le nom d'utilisateur qui apparaîtra sur Discord
DISCORD_USERNAME="NodeSentinel"

# ==========================================
# SEUILS D'ALERTE (en pourcentage)
# ==========================================
# Seuil d'alerte pour l'utilisation CPU
CPU_THRESHOLD="90"
# Seuil d'alerte pour l'utilisation de la RAM
RAM_THRESHOLD="85"
# Seuil d'alerte pour l'utilisation de l'espace disque
DISK_THRESHOLD="90"

# ==========================================
# MODULES DE MONITORING
# ==========================================
# Activer/désactiver le monitoring de la charge (Load Average)
LOAD_MONITORING="true"
# Activer/désactiver le monitoring réseau
NETWORK_MONITORING="true"
# Activer/désactiver le monitoring Docker
DOCKER_MONITORING="true"

# ==========================================
# LOGS
# ==========================================
# Chemin du fichier de log
LOG_FILE="/var/log/nodesentinel.log"
# Niveau de log (DEBUG, INFO, WARN, ERROR, CRITICAL)
LOG_LEVEL="INFO"
# Taille maximale du fichier de log en octets (10MB par défaut)
LOG_MAX_SIZE="10485760"

# ==========================================
# PARAMÈTRES GÉNÉRAUX
# ==========================================
# Intervalle de vérification en secondes
CHECK_INTERVAL="300"
# Surcharge du nom d'hôte (laisser vide pour utiliser le nom réel)
HOSTNAME_OVERRIDE=""
# Points de montage disque à surveiller (séparés par des espaces)
DISK_MOUNT_POINTS="/"
