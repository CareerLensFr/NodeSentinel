CPU_WARN_THRESHOLD="75"
CPU_THRESHOLD="90"
IOWAIT_THRESHOLD="40"

RAM_WARN_THRESHOLD="75"
RAM_THRESHOLD="85"
SWAP_THRESHOLD="80"

DISK_WARN_THRESHOLD="80"
DISK_THRESHOLD="90"
INODE_THRESHOLD="90"

LOAD_WARN_MULTIPLIER="1.5"
LOAD_CRIT_MULTIPLIER="2.0"

TEMP_WARN_THRESHOLD="75"
TEMP_THRESHOLD="85"

NET_BW_THRESHOLD_MBPS="100"
TOP_PROCESS_COUNT="5"

LOAD_MONITORING="true"
TEMP_MONITORING="true"
SWAP_MONITORING="true"
NETWORK_MONITORING="true"
DOCKER_MONITORING="true"

ALERT_COOLDOWN="1800"
